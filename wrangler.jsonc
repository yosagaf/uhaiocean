{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uhaiocean",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Répertoire = racine du site ; exclusions : `.assetsignore` (sinon `.git/` part en prod).
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
